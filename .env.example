# ─── Servidor ───────────────────────────────────────────
PORT=3000

# ─── Base de datos PostgreSQL ────────────────────────────
# Si usas Docker (recomendado):
DATABASE_URL=postgresql://nutrovia:nutrovia123@localhost:5432/nutrovia_db
# Si tienes PostgreSQL local nativo:
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/nutrovia_db

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro_123456

# ─── Stripe (pagos) ─────────────────────────────────────
# Obtén tus claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
# Obtén el webhook secret con: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Plan / Suscripción ──────────────────────────────────
# Días de prueba gratuita y precio mensual del plan Pro
TRIAL_DAYS=7
PLAN_PRICE_EUR=14
# Días sin actividad (actualizar valores o responder) antes de preguntar por el progreso
CHECKIN_INTERVAL_DAYS=7

# ─── IA (planes personalizados — opcional) ───────────────
# Si se define OPENAI_API_KEY, el contenido del plan (menú, entrenamiento,
# suplementos) lo genera la IA. Sin clave, se usa el motor determinista.
# Por defecto usa Groq (gratis): la clave va en OPENAI_API_KEY (gsk_...).
# Otros proveedores compatibles (OpenAI, DeepInfra, Fireworks...) cambiando
# AI_PLAN_API_URL y AI_PLAN_MODEL.
OPENAI_API_KEY=gsk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_PLAN_MODEL=openai/gpt-oss-120b
# AI_PLAN_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_PLAN_TIMEOUT_MS=45000 (requiere Default Max Duration >= 45s en Vercel)
# Reintentos con backoff para 429/5xx/timeout (el free tier de Groq limita por minuto)
# AI_PLAN_MAX_RETRIES=2
# AI_PLAN_RETRY_BASE_DELAY_MS=2000
# AI_PLAN_RETRY_MAX_DELAY_MS=10000

# ─── Email (SMTP) ────────────────────────────────────────
# Para Gmail: activa "Contraseñas de aplicación" en tu cuenta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_contraseña_de_aplicación
EMAIL_FROM=NutroVia <tu_email@gmail.com>
# Correo donde NutroVia recibe avisos de nuevos usuarios registrados
ADMIN_EMAIL=tu_email@gmail.com

# ─── App ─────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development
